# Webhook.site + SSRF worker env.

# Worker: Redis (must match service name in compose)
WEBHOOK_REDIS_HOST=webhook-site-redis
WEBHOOK_REDIS_PORT=6379
WEBHOOK_REDIS_DB=0

# Worker: Cyborg callback
AKTO_DASHBOARD_URL=https://cyborg.akto.io
# AKTO_SSRF_CALLBACK_PATH=/tools/ssrf-hit
CYBORG_TOOLS_STATIC_TOKEN=
