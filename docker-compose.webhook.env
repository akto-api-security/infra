# Webhook.site + SSRF worker env.

# --- Webhook.site ---
APP_DOMAIN=webhook.test-util.akto.io
APP_ENV=dev
APP_DEBUG=true
APP_URL=https://webhook.test-util.akto.io
APP_LOG=errorlog
DB_CONNECTION=sqlite
REDIS_HOST=webhook-site-redis
BROADCAST_DRIVER=redis
CACHE_DRIVER=redis
QUEUE_DRIVER=redis
ECHO_HOST_MODE=path

# --- Laravel Echo Server ---
LARAVEL_ECHO_SERVER_AUTH_HOST=http://webhook-site
LARAVEL_ECHO_SERVER_HOST=0.0.0.0
LARAVEL_ECHO_SERVER_PORT=6001
ECHO_REDIS_PORT=6379
ECHO_REDIS_HOSTNAME=webhook-site-redis
ECHO_PROTOCOL=http
ECHO_ALLOW_CORS=true
ECHO_ALLOW_ORIGIN=*
ECHO_ALLOW_METHODS=*
ECHO_ALLOW_HEADERS=*

# --- Worker ---
WEBHOOK_REDIS_HOST=webhook-site-redis
WEBHOOK_REDIS_PORT=6379
WEBHOOK_REDIS_DB=0

# Worker: Cyborg callback
AKTO_DASHBOARD_URL=https://cyborg.akto.io
# AKTO_SSRF_CALLBACK_PATH=/tools/ssrf-hit
CYBORG_TOOLS_STATIC_TOKEN=
