# Kafka Configuration
KAFKA_BROKER_URL=kafka:9092
KAFKA_ENABLED=true
KAFKA_TOPIC_FEEDBACK=akto.agent-traffic.feedback
KAFKA_TOPIC_DETECTION=akto.agent-traffic.detection
KAFKA_MAX_POLL_RECORDS=100

# Service Configuration
PORT=8093
SERVICE_MODE=api
CHROMA_PERSIST_DIR=/app/chroma_db
PYTHONUNBUFFERED=1

# Embedding Configuration (Optional)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# OPENAI_API_KEY_FOR_EMBEDDINGS=
# OPENAI_API_KEY=

# Guardrail Configuration (Optional - defaults in config.py)
# MIN_TRAFFIC_FOR_GUARDRAIL=30
# MIN_TOKENS_FOR_GUARDRAIL=5

# HuggingFace Cache
HF_HOME=/app/.cache/huggingface
TRANSFORMERS_VERBOSITY=error
HF_HUB_VERBOSITY=error

