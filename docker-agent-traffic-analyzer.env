# Agent Traffic Analyzer Environment Configuration
# This file is created automatically by the startup script at: ~/akto/infra/docker-agent-traffic-analyzer.env
# You can customize these values before running the startup script by setting environment variables

# Service Port
PORT=8093

# Python Configuration
PYTHONUNBUFFERED=1

# HuggingFace Model Cache Directory
HF_HOME=/app/.cache/huggingface

# Docker Image Tag (used when pulling from registry)
# Set this via: export DOCKER_TAG=saas (or v1.0.0, latest, etc.)
DOCKER_TAG=latest

# HuggingFace Verbosity (optional, reduces log noise)
TRANSFORMERS_VERBOSITY=error
HF_HUB_VERBOSITY=error

