DATABASE_ABSTRACTOR_SERVICE_URL=https://cyborg.akto.io
DATABASE_ABSTRACTOR_SERVICE_TOKEN=<token>
LOG_LEVEL=error
GUARDRAIL_FIELD_MAPPING="POST:/v1/chat/completions:messages.role=user.content|messages.role=user.content.0.text"
GUARDRAILS_BACKPRESSURE_AVG_LATENCY_MS=1000
BLOCK_LOGS=true
GUARDRAILS_SKIP_PII_REDACTION=true
