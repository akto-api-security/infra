<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<SharedFlowBundle name="${sharedflow_name}">
  <Description>Akto traffic capture shared flow generated by Terraform</Description>
  <Policies>
    <Policy>AktoJavascript</Policy>
  </Policies>
  <Resources>
    <Resource>jsc://AktoPolicy.js</Resource>
  </Resources>
  <SharedFlows>
    <SharedFlow>default</SharedFlow>
  </SharedFlows>
</SharedFlowBundle>
